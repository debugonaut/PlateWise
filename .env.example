# PlateWise Environment Configuration
# Add your Groq API key (starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override primary models if desired
# Default chat model falls back through: openai/gpt-oss-120b -> qwen/qwen3.8-27b -> llama-3.3-70b-versatile
# GROQ_MODEL=openai/gpt-oss-120b

# Default vision model falls back through: qwen/qwen3.8-27b -> meta-llama/llama-4-scout-17b-16e-instruct -> llama-3.2-11b-vision-preview
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
