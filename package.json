{
  "name": "platewise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered fridge-to-recipe web app with Groq Vision and LLM",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev": "npm run dev --prefix frontend",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "groq-sdk": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}